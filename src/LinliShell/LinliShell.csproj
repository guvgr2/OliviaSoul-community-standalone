<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LinliLetters</AssemblyName>
    <RootNamespace>LinliLetters</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <!-- ★ 不设这条，exe 就顶着 .NET 的默认图标 —— 开始菜单、任务栏、桌面快捷方式
         继承的都是 exe 自己的图标，安装程序里设了 SetupIconFile 也救不回来。
         图标只有一份真源，放在 installer\ 下，跟安装程序用的是同一个文件，
         免得以后改了一个忘了另一个。 -->
    <ApplicationIcon>..\..\installer\linli.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ★ 界面还是 HTML/CSS 画的（玻璃质感只有浏览器引擎能渲染），但窗口是我们自己的：
           不再是外壳去拉起 Edge 的应用窗口（msedge 的 app 模式）。换来：
             · 任务栏上是这个程序自己的名字和图标（以前是 Edge，图标取网页 favicon）；
             · 能真的收进托盘；
             · 页面能反过来叫窗口拖动、最小化、关闭。
         WebView2 用的是系统里已经装好的运行时（本机两个版本都在），不往包里塞内核；
         运行时找不到时 MainWindow 自己退回系统浏览器。
         ★ XML 注释里不能写连续两个连字符，所以这里不写那个命令行开关的原样。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

</Project>
